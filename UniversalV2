local loadingProgress = 0

-- Kart animasyonu (hafif büyüyüp küçülme)
task.spawn(function()
    local tween = TweenService:Create(LoadingCard, TweenInfo.new(0.5, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {Size = UDim2.new(0, 390, 0, 230), Position = UDim2.new(0.5, -195, 0.5, -115)})
    tween:Play()
    tween.Completed:Wait()
    local tweenBack = TweenService:Create(LoadingCard, TweenInfo.new(0.5, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {Size = UDim2.new(0, 380, 0, 220), Position = UDim2.new(0.5, -190, 0.5, -110)})
    tweenBack:Play()
end)

task.spawn(function()
    local phases = {"Yükleniyor", "Ayarlar yapılıyor", "Script hazırlanıyor", "Açılıyor"}
    local phaseIndex = 1
    
    while loadingProgress < 100 do
        loadingProgress = math.min(loadingProgress + 1, 100)
        BarFill.Size = UDim2.new(loadingProgress / 100, 0, 1, 0)
        StatusText.Text = phases[phaseIndex] .. "... %" .. loadingProgress
        
        -- Her %25'te yazıyı değiştir
        if loadingProgress % 25 == 0 and phaseIndex < #phases then
            phaseIndex = phaseIndex + 1
        end
        
        task.wait(0.1) -- 100 * 0.1 = 10 saniye
    end
    
    StatusText.Text = "Hazır!"
    task.wait(0.5)
    LoadingGui:Destroy()
    MainFrame.Visible = true -- Ana menü otomatik açılır
end)

