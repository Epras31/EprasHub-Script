local function refreshDedicatedPlayerList(filterText)
    for _, child in ipairs(tpListScrolling:GetChildren()) do
        if child:IsA("Frame") then child:Destroy() end
    end

    local yPos = 0
    filterText = string.lower(filterText or "")

    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= player and (filterText == "" or string.find(string.lower(p.Name), filterText)) then
            local pRow = create("Frame", {
                Position = UDim2.fromOffset(0, yPos),
                Size = UDim2.new(1, -6, 0, 42),
                BackgroundColor3 = COLORS.Card,
                ZIndex = 23
            }, tpListScrolling)
            rounded(pRow, 8)
            local rowStroke = outline(pRow, COLORS.PurpleDark, 1)

            local nameLbl = create("TextLabel", {
                Position = UDim2.fromOffset(12, 0),
                Size = UDim2.new(1, -210, 1, 0),
                BackgroundTransparency = 1,
                Text = p.Name,
                TextColor3 = COLORS.Text,
                TextSize = 13,
                Font = Enum.Font.GothamBold,
                TextXAlignment = Enum.TextXAlignment.Left,
                ZIndex = 24
            }, pRow)

            local tpBtn = create("TextButton", {
                Position = UDim2.new(1, -200, 0.5, -14),
                Size = UDim2.new(0, 55, 0, 28),
                BackgroundColor3 = COLORS.PurpleDark,
                Text = getTxt("tp"),
                TextColor3 = COLORS.Text,
                TextSize = 11,
                Font = Enum.Font.GothamBold,
                ZIndex = 24
            }, pRow)
            rounded(tpBtn, 6)
            tpBtn.MouseButton1Click:Connect(function()
                if p.Character and p.Character:FindFirstChild("HumanoidRootPart") and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
                    player.Character.HumanoidRootPart.CFrame = p.Character.HumanoidRootPart.CFrame + Vector3.new(0, 3, 0)
                end
            end)

            local isFollowing = false
            local followBtn = create("TextButton", {
                Position = UDim2.new(1, -140, 0.5, -14),
                Size = UDim2.new(0, 65, 0, 28),
                BackgroundColor3 = COLORS.PurpleDark,
                Text = getTxt("follow"),
                TextColor3 = COLORS.Text,
                TextSize = 10,
                Font = Enum.Font.GothamBold,
                ZIndex = 24
            }, pRow)
            rounded(followBtn, 6)

            followBtn.MouseButton1Click:Connect(function()
                isFollowing = not isFollowing
                if isFollowing then
                    followBtn.Text = getTxt("stopFollow")
                    followBtn.BackgroundColor3 = COLORS.Red
                    rowStroke.Color = COLORS.Green
                    pRow.BackgroundColor3 = Color3.fromRGB(20, 40, 30)
                    task.spawn(function()
                        while isFollowing do
                            if p.Character and p.Character:FindFirstChild("HumanoidRootPart") and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
                                player.Character.HumanoidRootPart.CFrame = p.Character.HumanoidRootPart.CFrame * CFrame.new(0, 0, 3)
                            end
                            task.wait(0.1)
                        end
                    end)
                else
                    followBtn.Text = getTxt("follow")
                    followBtn.BackgroundColor3 = COLORS.PurpleDark
                    rowStroke.Color = COLORS.PurpleDark
                    pRow.BackgroundColor3 = COLORS.Card
                end
            end)

            local specBtn = create("TextButton", {
                Position = UDim2.new(1, -70, 0.5, -14),
                Size = UDim2.new(0, 58, 0, 28),
                BackgroundColor3 = COLORS.PurpleDark,
                Text = getTxt("spectate"),
                TextColor3 = COLORS.Text,
                TextSize = 10,
                Font = Enum.Font.GothamBold,
                ZIndex = 24
            }, pRow)
            rounded(specBtn, 6)

            specBtn.MouseButton1Click:Connect(function()
                if spectatingTarget == p then
                    spectatingTarget = nil
                    specBtn.Text = getTxt("spectate")
                    specBtn.BackgroundColor3 = COLORS.PurpleDark
                    workspace.CurrentCamera.CameraSubject = player.Character and player.Character.Humanoid
                else
                    spectatingTarget = p
                    specBtn.Text = getTxt("stopSpectate")
                    specBtn.BackgroundColor3 = COLORS.Red
                end
            end)

            yPos = yPos + 48
        end
    end
    tpListScrolling.CanvasSize = UDim2.new(0, 0, 0, yPos)
end

tpSearchBox:GetPropertyChangedSignal("Text"):Connect(function()
    refreshDedicatedPlayerList(tpSearchBox.Text)
end)

