for idx, tabData in ipairs(tabs) do
    local btn = create("TextButton", {
        Position = UDim2.fromOffset(0, (idx - 1) * 58),
        Size = UDim2.new(1, 0, 0, 50),
        BackgroundColor3 = idx == 1 and COLORS.Card or COLORS.Panel,
        Text = "",
        ZIndex = 22
    }, sidebar)
    rounded(btn, 10)
    local stroke = outline(btn, COLORS.Purple, 0)

    create("TextLabel", {
        Position = UDim2.fromOffset(14, 0),
        Size = UDim2.fromOffset(24, 50),
        BackgroundTransparency = 1,
        Text = tabData[1],
        TextSize = 18,
        ZIndex = 23
    }, btn)

    local lbl = create("TextLabel", {
        Position = UDim2.fromOffset(48, 0),
        Size = UDim2.new(1, -52, 1, 0),
        BackgroundTransparency = 1,
        Text = getTxt(tabData[2]),
        TextColor3 = COLORS.Text,
        TextSize = 14,
        Font = Enum.Font.GothamMedium,
        TextXAlignment = Enum.TextXAlignment.Left,
        ZIndex = 23
    }, btn)

    btn.MouseEnter:Connect(function()
        if pageFrames[idx].Visible == false then
            TweenService:Create(btn, TweenInfo.new(0.2), { Position = UDim2.fromOffset(6, (idx - 1) * 58) }):Play()
            TweenService:Create(stroke, TweenInfo.new(0.2), { Thickness = 1 }):Play()
        end
    end)

    btn.MouseLeave:Connect(function()
        if pageFrames[idx].Visible == false then
            TweenService:Create(btn, TweenInfo.new(0.2), { Position = UDim2.fromOffset(0, (idx - 1) * 58) }):Play()
            TweenService:Create(stroke, TweenInfo.new(0.2), { Thickness = 0 }):Play()
        end
    end)

    task.spawn(function()
        while btn and btn.Parent do
            lbl.Text = getTxt(tabData.id or tabData[2])
            task.wait(0.5)
        end
    end)

    btn.MouseButton1Click:Connect(function()
        for i, p in ipairs(pageFrames) do p.Visible = (i == idx) end
        for i, b in ipairs(tabButtons) do
            local isSelected = (i == idx)
            TweenService:Create(b, TweenInfo.new(0.25), {
                BackgroundColor3 = isSelected and COLORS.Card or COLORS.Panel,
                Position = isSelected and UDim2.fromOffset(8, (i - 1) * 58) or UDim2.fromOffset(0, (i - 1) * 58)
            }):Play()
            local bStroke = b:FindFirstChildOfClass("UIStroke")
            if bStroke then
                TweenService:Create(bStroke, TweenInfo.new(0.25), { Thickness = isSelected and 1.5 or 0 }):Play()
            end
        end
        if idx == 5 then refreshDedicatedPlayerList("") end
    end)
    tabButtons[idx] = btn
end

