task.spawn(function()
    while main and main.Parent do
        task.wait(math.random(6, 12) / 10)
        local size = math.random(12, 36)
        local bubble = create("Frame", {
            Position = UDim2.new(math.random(5, 95) / 100, 0, 1.05, 0),
            Size = UDim2.fromOffset(size, size),
            BackgroundColor3 = (math.random(1, 2) == 1 and COLORS.Purple or COLORS.PurpleDark),
            BackgroundTransparency = math.random(65, 85) / 100,
            ZIndex = 12
        }, bubbleContainer)
        rounded(bubble, size / 2)

        local duration = math.random(4, 7)
        local targetX = bubble.Position.X.Scale + (math.random(-10, 10) / 100)
        local tween = TweenService:Create(bubble, TweenInfo.new(duration, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            Position = UDim2.new(targetX, 0, -0.1, 0),
            BackgroundTransparency = 1
        })
        tween:Play()
        tween.Completed:Connect(function() bubble:Destroy() end)
    end
end)

local isMenuOpen = false
local function setMenuVisible(visible)
    if not isFullyLoaded then return end
    if visible and not isMenuOpen then
        isMenuOpen = true
        main.Visible = true
        main.Size = UDim2.fromOffset(0, 0)
        main.Rotation = -5
        local tweenInfo = TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
        TweenService:Create(main, tweenInfo, { Size = UDim2.fromOffset(880, 540), Rotation = 0 }):Play()
    elseif not visible and isMenuOpen then
        isMenuOpen = false
        local tweenInfo = TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.In)
        local tween = TweenService:Create(main, tweenInfo, { Size = UDim2.fromOffset(0, 0), Rotation = 5 })
        tween:Play()
        tween.Completed:Connect(function()
            if not isMenuOpen then main.Visible = false end
        end)
    end
end

-- YÜKLEME AŞAMALARI
task.spawn(function()
    local initStages = {
        {progress = 0.15, text = "Bypassing Anti-Cheat Hooks & Integrity Checks..."},
        {progress = 0.40, text = "Pre-loading ESP Renderers & Highlighting Vectors..."},
        {progress = 0.70, text = "Compiling Aimbot Target Resolution & FOV Matrix..."},
        {progress = 0.90, text = "Initializing User Interface Animations & Styles..."},
        {progress = 1.00, text = "Loading Complete! Launching EPRAS HUB..."}
    }
    
    for _, stage in ipairs(initStages) do
        local startP = tonumber(loadPercentLbl.Text:match("%d+")) / 100
        local targetP = stage.progress
        loadTipLabel.Text = stage.text
        
        local t = 0
        while t < 1 do
            t = t + 0.1
            local currP = startP + (targetP - startP) * t
            loadBarFill.Size = UDim2.new(currP, 0, 1, 0)
            loadPercentLbl.Text = math.floor(currP * 100) .. "%"
            task.wait(0.04)
        end
    end
    
    task.wait(0.3)
    isFullyLoaded = true
    TweenService:Create(loader, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.In), { Size = UDim2.fromOffset(0, 0) }):Play()
    task.wait(0.3)
    loader:Destroy()
    setMenuVisible(true)
end)

