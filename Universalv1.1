local function createSlider(parent, y, titleKey, descKey, emoji, min, max, default, isSmoothBar, callback)
    local val = default
    local card = create("Frame", {
        Position = UDim2.fromOffset(0, y),
        Size = UDim2.new(1, -10, 0, 68),
        BackgroundColor3 = COLORS.Card,
