        TextSize = 18,
        ZIndex = 23
    }, card)
    rounded(card:FindFirstChildOfClass("TextLabel"), 8)

    local tLbl = create("TextLabel", {
        Position = UDim2.fromOffset(64, 10),
        Size = UDim2.new(1, -150, 0, 20),
        BackgroundTransparency = 1,
        Text = getTxt(titleKey),
        TextColor3 = COLORS.Text,
        TextSize = 14,
        Font = Enum.Font.GothamBold,
        TextXAlignment = Enum.TextXAlignment.Left,
        ZIndex = 23
    }, card)

    local valLbl = create("TextLabel", {
        Position = UDim2.new(1, -70, 0, 10),
        Size = UDim2.fromOffset(55, 20),
        BackgroundTransparency = 1,
        Text = tostring(default),
        TextColor3 = isSmoothBar and (default <= 3 and COLORS.Green or (default <= 7 and COLORS.Yellow or COLORS.Red)) or COLORS.Purple,
        TextSize = 13,
        Font = Enum.Font.GothamBold,
        TextXAlignment = Enum.TextXAlignment.Right,
        ZIndex = 23
    }, card)

    task.spawn(function()
        while card and card.Parent do
            tLbl.Text = getTxt(titleKey)
            task.wait(0.5)
        end
    end)

    local sliderBg = create("Frame", {
        Position = UDim2.fromOffset(64, 40),
        Size = UDim2.new(1, -80, 0, 6),
        BackgroundColor3 = Color3.fromRGB(45, 33, 68),
        ZIndex = 23
    }, card)
    rounded(sliderBg, 3)

    local pct = (default - min) / (max - min)
    local fill = create("Frame", {
        Size = UDim2.new(pct, 0, 1, 0),
        BackgroundColor3 = isSmoothBar and (default <= 3 and COLORS.Green or (default <= 7 and COLORS.Yellow or COLORS.Red)) or COLORS.Purple,
        ZIndex = 24
    }, sliderBg)
    rounded(fill, 3)

    local handle = create("TextButton", {
        Position = UDim2.new(pct, -6, 0.5, -6),
        Size = UDim2.fromOffset(12, 12),
        BackgroundColor3 = COLORS.White,
        Text = "",
        ZIndex = 25
    }, sliderBg)
    rounded(handle, 6)

    local dragging = false
    handle.InputBegan:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1 then dragging = true end
    end)
    UserInputService.InputEnded:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = false
        end
    end)

    UserInputService.InputChanged:Connect(function(inp)
        if dragging and inp.UserInputType == Enum.UserInputType.MouseMovement then
            local p = math.clamp((inp.Position.X - sliderBg.AbsolutePosition.X) / sliderBg.AbsoluteSize.X, 0, 1)
            val = math.floor(min + (max - min) * p + 0.5)
            local currentPct = (val - min) / (max - min)
            fill.Size = UDim2.new(currentPct, 0, 1, 0)
            handle.Position = UDim2.new(currentPct, -6, 0.5, -6)
            valLbl.Text = tostring(val)
            
            if isSmoothBar then
                local col = (val <= 3 and COLORS.Green or (val <= 7 and COLORS.Yellow or COLORS.Red))
                fill.BackgroundColor3 = col
                valLbl.TextColor3 = col
            end

            if callback then callback(val) end
        end
    end)
end

