RunService.RenderStepped:Connect(function()
    fovGui.Visible = cheatFlags.DrawFOV
    crosshairGui.Visible = cheatFlags.Crosshair

    if cheatFlags.DrawFOV then
        fovGui.Size = UDim2.fromOffset(cheatFlags.FOVRadius * 2, cheatFlags.FOVRadius * 2)
        rounded(fovGui, cheatFlags.FOVRadius)
    end

    local cam = workspace.CurrentCamera
    local mousePos = UserInputService:GetMouseLocation()
    local targetInFov = false
    local closestTarget = nil
    local shortestDist = cheatFlags.FOVRadius

    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= player and p.Character and p.Character:FindFirstChild("Head") and p.Character:FindFirstChild("Humanoid") and p.Character.Humanoid.Health > 0 then
            local head = p.Character.Head
            local screenPoint, onScreen = cam:WorldToViewportPoint(head.Position)
            if onScreen then
                local screenDist = (Vector2.new(screenPoint.X, screenPoint.Y) - mousePos).Magnitude
                if screenDist <= cheatFlags.FOVRadius then
                    targetInFov = true
                    if screenDist < shortestDist then
                        shortestDist = screenDist
                        closestTarget = head
                    end
                end
            end
        end
    end

    if targetInFov then
        fovStroke.Color = COLORS.Green
    else
        fovStroke.Color = COLORS.Purple
    end

    local isRightMouseDown = UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2)
    if cheatFlags.Aimbot and isRightMouseDown and closestTarget then
        local targetCFrame = CFrame.new(cam.CFrame.Position, closestTarget.Position)
        local smoothFactor = math.clamp(cheatFlags.AimbotSmoothness / 10, 0.05, 1)
        cam.CFrame = cam.CFrame:Lerp(targetCFrame, smoothFactor)
    end
end)

-- Uçuş ve Hareket Mantığı
local flyVelocity, flyGyro

RunService.Heartbeat:Connect(function()
    local char = player.Character
    if char and char:FindFirstChild("Humanoid") and char:FindFirstChild("HumanoidRootPart") then
        local humanoid = char.Humanoid
        local rootPart = char.HumanoidRootPart

        if cheatFlags.SpeedFix then
            humanoid.WalkSpeed = cheatFlags.WalkSpeed
        elseif cheatFlags.WalkSpeed > 16 then
            humanoid.WalkSpeed = cheatFlags.WalkSpeed
        end

        pcall(function()
            if humanoid.UseJumpPower then
                humanoid.JumpPower = cheatFlags.JumpPower
            else
                humanoid.JumpHeight = cheatFlags.JumpPower * 0.4
            end
        end)

        if cheatFlags.Noclip then
            for _, part in ipairs(char:GetDescendants()) do
                if part:IsA("BasePart") then part.CanCollide = false end
            end
        end

        if cheatFlags.SpinBot then
            rootPart.CFrame = rootPart.CFrame * CFrame.Angles(0, math.rad(cheatFlags.SpinSpeed), 0)
        end

        if cheatFlags.FlyMode then
            if not flyVelocity then
                flyVelocity = Instance.new("BodyVelocity")
                flyVelocity.MaxForce = Vector3.new(9e9, 9e9, 9e9)
                flyVelocity.Velocity = Vector3.zero
                flyVelocity.Parent = rootPart
            end
            if not flyGyro then
                flyGyro = Instance.new("BodyGyro")
                flyGyro.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
                flyGyro.CFrame = rootPart.CFrame
                flyGyro.Parent = rootPart
            end

            local cam = workspace.CurrentCamera
            local moveDir = Vector3.zero
            if UserInputService:IsKeyDown(Enum.KeyCode.W) then moveDir = moveDir + cam.CFrame.LookVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.S) then moveDir = moveDir - cam.CFrame.LookVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.D) then moveDir = moveDir + cam.CFrame.RightVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.A) then moveDir = moveDir - cam.CFrame.RightVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.Space) then moveDir = moveDir + Vector3.new(0, 1, 0) end
            if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then moveDir = moveDir - Vector3.new(0, 1, 0) end

            flyVelocity.Velocity = moveDir * cheatFlags.FlySpeed
            flyGyro.CFrame = cam.CFrame
            humanoid.PlatformStand = true
        else
            if flyVelocity then flyVelocity:Destroy(); flyVelocity = nil end
            if flyGyro then flyGyro:Destroy(); flyGyro = nil end
            if humanoid.PlatformStand then humanoid.PlatformStand = false end
        end
    end
end)

