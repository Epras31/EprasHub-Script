-- ESP & İsim + Sağlık
local espObjects = {}
local function clearEspForPlayer(p)
    if espObjects[p] then
        if espObjects[p].hl then espObjects[p].hl:Destroy() end
        if espObjects[p].info then espObjects[p].info:Destroy() end
        espObjects[p] = nil
    end
end

RunService.RenderStepped:Connect(function()
    if not (cheatFlags.BoxESP or cheatFlags.NameHealth) then
        for p, _ in pairs(espObjects) do clearEspForPlayer(p) end
        return
    end

    local cam = workspace.CurrentCamera
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= player and p.Character and p.Character:FindFirstChild("HumanoidRootPart") and p.Character:FindFirstChild("Humanoid") then
            local char = p.Character
            local hrp = char.HumanoidRootPart
            local hum = char.Humanoid

            if not espObjects[p] then espObjects[p] = {} end

            if cheatFlags.BoxESP then
                if not espObjects[p].hl then
                    local hl = Instance.new("Highlight")
                    hl.Adornee = char
                    hl.FillColor = COLORS.Purple
                    hl.OutlineColor = COLORS.White
                    hl.FillTransparency = 0.6
                    hl.Parent = char
                    espObjects[p].hl = hl
                end
            else
                if espObjects[p].hl then espObjects[p].hl:Destroy(); espObjects[p].hl = nil end
            end

            if cheatFlags.NameHealth then
                if not espObjects[p].info then
                    local bill = Instance.new("BillboardGui")
                    bill.Size = UDim2.fromOffset(200, 50)
                    bill.AlwaysOnTop = true
                    bill.StudsOffset = Vector3.new(0, 3, 0)
                    bill.Parent = hrp

                    local lbl = Instance.new("TextLabel")
                    lbl.Size = UDim2.fromScale(1, 1)
                    lbl.BackgroundTransparency = 1
                    lbl.TextColor3 = COLORS.White
                    lbl.TextSize = 12
                    lbl.Font = Enum.Font.GothamBold
                    lbl.TextStrokeTransparency = 0.5
                    lbl.Parent = bill
                    espObjects[p].info = bill
                end

                local bill = espObjects[p].info
                if bill and bill:FindFirstChildOfClass("TextLabel") then
                    local dist = math.floor((hrp.Position - cam.CFrame.Position).Magnitude)
                    local hp = math.floor(hum.Health)
                    bill.TextLabel.Text = string.format("[%s] | HP: %d | %dm", p.Name, hp, dist)
                end
            else
                if espObjects[p].info then espObjects[p].info:Destroy(); espObjects[p].info = nil end
            end
        else
            clearEspForPlayer(p)
        end
    end
end)

